{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "process",
			"label": "C/C++ (debug): clang++ コンフィグレーション",
			"command": "cmake",
			"args": [
				"-B",
				"${workspaceFolder}/build/debug",
				"-DCMAKE_BUILD_TYPE=Debug",
				"-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/vcpkg/scripts/buildsystems/vcpkg.cmake",
				"-S",
				"${workspaceFolder}"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build",
			"detail": "コンパイラ: /usr/bin/clang++"
		},
		{
			"type": "process",
			"label": "C/C++ (debug): clang++ ビルド",
			"command": "cmake",
			"args": [
				"--build",
				"${workspaceFolder}/build/debug",
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build",
			"detail": "コンパイラ: /usr/bin/clang++"
		},
		{
			"type": "process",
			"label": "C/C++ (debug): clang++ 実行",
			"command": "./bin/debug/cpp-neural-network",
			"args": [],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build",
			"detail": "コンパイラ: /usr/bin/clang++"
		},
		{
			"type": "process",
			"label": "C/C++ (debug): clang++ ビルドして実行",
			"command": "cmake",
			"args": [
				"--build",
				"${workspaceFolder}/build/debug",
				"&&",
				"${workspaceFolder}/bin/debug/cpp-neural-network"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build",
			"detail": "コンパイラ: /usr/bin/clang++"
		},
		{
			"type": "process",
			"label": "C/C++ (release): clang++ コンフィグレーション",
			"command": "cmake",
			"args": [
				"-B",
				"${workspaceFolder}/build/release",
				"-DCMAKE_BUILD_TYPE=Release",
				"-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/vcpkg/scripts/buildsystems/vcpkg.cmake",
				"-S",
				"${workspaceFolder}"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build",
			"detail": "コンパイラ: /usr/bin/clang++"
		},
		{
			"type": "process",
			"label": "C/C++ (release): clang++ ビルド",
			"command": "cmake",
			"args": [
				"--build",
				"${workspaceFolder}/build/release",
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build",
			"detail": "コンパイラ: /usr/bin/clang++"
		},
		{
			"type": "process",
			"label": "C/C++ (release): clang++ 実行",
			"command": "./bin/release/cpp-neural-network",
			"args": [],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build",
			"detail": "コンパイラ: /usr/bin/clang++"
		},
		{
			"type": "process",
			"label": "C/C++ (release): clang++ ビルドして実行",
			"command": "cmake",
			"args": [
				"--build",
				"${workspaceFolder}/build/release",
				"&&",
				"${workspaceFolder}/bin/release/cpp-neural-network"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build",
			"detail": "コンパイラ: /usr/bin/clang++"
		}
	]
}