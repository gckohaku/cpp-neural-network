{
    "indentRainbow.indicatorStyle": "light",
    "indentRainbow.lightIndicatorStyleLineWidth": 2,
    "indentRainbow.colors": [
        "rgba(255,255,64,0.25)",
        "rgba(127,255,127,0.25)",
        "rgba(255,127,255,0.25)",
        "rgba(79,236,236,0.25)"
    ],
    "cSpell.words": [
        "cblas",
        "Dont",
        "Eigen",
        "hadamard",
        "mdspan",
        "multipliable",
        "Multipliable",
        "saxpy",
        "sgemm"
    ],
    "C_Cpp.intelliSenseEngine": "disabled",
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/build/editor",
        "--query-driver=/usr/bin/clang++,/usr/bin/clang",
        "-clang-tidy"
    ],
    "C_Cpp.formatting": "default",
    "C_Cpp.vcFormat.indent.namespaceContents": true,
    "workbench.colorTheme": "Dark Modern",
    "files.autoSave": "off",
    "editor.minimap.enabled": false,
    "cmake.configureSettings": {
        "CMAKE_TOOLCHAIN_FILE": "${workspaceFolder}/vcpkg/scripts/buildsystems/vcpkg.cmake"
    },
    "cmake.buildDirectory": "${workspaceFolder}/build/editor",
}